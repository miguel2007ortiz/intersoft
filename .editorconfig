# Editor configuration, see https://editorconfig.org
root = true

# Codificacion UTF-8 y final de linea determinista para todo el repo.
# Completa el modelo del frontend (.editorconfig) cubriendo backend/ y docs/.
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
max_line_length = off
trim_trailing_whitespace = false

[*.{yml,yaml,json,ts,js,css,html}]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab