# ============================================================
#  InterSoft - Backend (plantilla de entorno)
#  Copia este archivo como `.env` y ajusta los valores.
#    Windows:  copy .env.example .env
#    Mac/Linux: cp .env.example .env
#  NO subir .env a git (esta en .gitignore).
# ============================================================

# --- Django ---------------------------------------------------
SECRET_KEY=cambia-esta-clave-en-produccion-intersoft-2026
# DEBUG=True solo en tu maquina local. En cualquier entorno
# compartido (demo, produccion) debe quedar en False: evita que se
# muestren trazas de error con datos de la base de datos.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos - MySQL 8 (Laragon en desarrollo) ----------
DB_NAME=intersoft1_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS / Frontend ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_URL=http://localhost:4200

# --- Correo (fase 9) ------------------------------------------
# Si EMAIL_BACKEND queda vacio:
#   DEBUG=True  -> consola de Django (no envia; ideal en desarrollo)
#   DEBUG=False -> SMTP real (require EMAIL_HOST/USER/PASSWORD)
# Para enviar correo de verdad (recuperacion de contrasena y
# notificaciones) completa las variables SMTP.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@intersoft.co

# --- Asistente IA (fase 8) ------------------------------------
# Proveedores soportados: mock | groq | openai
#   mock   = sin salida a internet (desarrollo/demo).
#   groq   = Llama 3.3 70B GRATIS (limitado). API compatible con OpenAI.
#            Necesitas una API key gratis en https://console.groq.com.
#   openai = necesita una API key de OpenAI (no gratis).
#
# Ejemplo listo para GROQ (descomenta y pon tu API key):
#   IA_PROVIDER=groq
#   IA_API_KEY=tu_clave_de_groq
#   IA_API_URL=https://api.groq.com/openai/v1/chat/completions
#   IA_MODEL=llama-3.3-70b-versatile
#
# Si dejas IA_API_KEY vacia (con cualquier proveedor) el sistema
# cae al modo mock para no romper el chat.
IA_PROVIDER=mock
IA_API_KEY=
IA_API_URL=
IA_MODEL=gpt-3.5-turbo
IA_TIMEOUT=20
IA_MAX_HISTORIAL=10

# --- Notificaciones / WhatsApp Business (fase 9) --------------
# WhatsApp se envia solo si WA_VINCULADO=True con WA_TOKEN y WA_NUMERO.
# Si no, el notificador cae al canal alterno por EMAIL.
WA_VINCULADO=False
WA_API_URL=https://graph.facebook.com/v18.0/
WA_TOKEN=
# Numero de telefono del remitente (se usa como "from" en la API de WhatsApp).
WA_NUMERO=
