# ============================================================
#  InterSoft - Backend (plantilla de entorno)
#  Copia este archivo como `.env` y ajusta los valores a tu entorno.
#    Windows:  copy .env.example .env
#    Mac/Linux: cp .env.example .env
#  NO subas tu `.env` a git (esta ignorado en el .gitignore del repo).
#  Aqui NO deben ir secretos reales: las claves van en tu `.env` local.
# ============================================================

# ------------------------------------------------ Cache (B1) ---
# Backend del cache: por defecto la BD MySQL (tabla CACHE_LOCATION,
# se crea con `python manage.py crear_cache`). En produccion con varios
# workers de gunicorn conviene compartir el cache (el LocMem es por
# proceso); opciones: dejar la BD (recomendado sin Redis instalado) o
# apuntar a Redis:
#   CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   CACHE_LOCATION=redis://127.0.0.1:6379/1
# La invalidacion por empresa (señales) funciona igual con ambos.
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=intersoft_cache

# ------------------------------------------------- Django ---
# Clave secreta usada para firmar tokens/sesiones.
#   - DEBUG=True  (desarrollo): puedes dejar el placeholder de abajo.
#   - DEBUG=False (produccion): OBLIGATORIO poner una clave real y aleatoria.
#     Genera una segura con:
#       python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#     La app NO arranca en produccion con el placeholder o sin clave.
SECRET_KEY=cambia-esta-clave-en-produccion-intersoft-2026

# DEBUG=True SOLO en tu maquina local. En cualquier entorno compartido
# (demo, staging, produccion) debe quedar en False.
DEBUG=True

# Hosts/dominios que Django aceptara. En produccion lista los dominios
# publicos separados por coma, SIN comodin (ej: api.intersoft.co,www.x.com).
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------ Base de datos ---
# MySQL 8 (en desarrollo suele usarse Laragon: root sin password).
DB_NAME=intersoft1_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --------------------------------------- CORS / Frontend / CSRF ---
# Origenes desde los que el navegador podra llamar a la API.
# En produccion pon el/los dominio/s del frontend (HTTPS).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Mismo conjunto para peticiones con cookies (CSRF). Opcional en desarrollo.
CSRF_TRUSTED_ORIGINS=http://localhost:4200
# URL publica del frontend (se usa en enlaces de correos, redirecciones...).
FRONTEND_URL=http://localhost:4200

# --------------------------------------------- Correo / SMTP -------
# Si EMAIL_BACKEND queda vacio:
#   DEBUG=True  -> backend de consola de Django (no envia; ideal en desarrollo)
#   DEBUG=False -> SMTP real (debes completar EMAIL_HOST/USER/PASSWORD)
# Para enviar correo de verdad (recuperacion de contrasena, notificaciones)
# completa las variables SMTP. Nunca subas el App Password real a git.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@intersoft.co

# ------------------------------------------- Asistente IA ---------
# Proveedores soportados: mock | groq | openai
#   mock   = sin salida a internet (desarrollo/demo).
#   groq   = API compatible con OpenAI; necesitas tu API key en
#            https://console.groq.com (nunca la subas al repo).
#   openai = necesitas tu API key de OpenAI.
# Si IA_API_KEY queda vacia, el sistema cae al modo mock para no romper.
IA_PROVIDER=mock
IA_API_KEY=
IA_API_URL=
IA_MODEL=gpt-3.5-turbo
IA_TIMEOUT=20
IA_MAX_HISTORIAL=10
# Rate-limit del chat por usuario: maximo de peticiones dentro de la ventana
# (en segundos) para evitar costes abusivos de la API cuando hay proveedor real.
IA_MAX_PETICIONES=15
IA_PETICIONES_VENTANA=60

# ------------------------------------- Facturacion electronica DIAN ---
# DIAN_MOCK=True (default) simula la aprobacion y genera comprobantes reales
# (PDF + XML) localmente. Cambia a False SOLO cuando tengas la habilitacion
# oficial: DIAN_MOCK=False usaria el Web Service SOAP real y necesita
# DIAN_USUARIO/DIAN_CLAVE (credenciales de habilitacion) y el certificado.
# Sin esas credenciales, con DIAN_MOCK=False el envio devuelve SIN_CREDENCIALES.
DIAN_MOCK=True
# URL del WSDL del servicio. Entorno de habilitacion (pruebas) por defecto;
# en produccion usa el ambito oficial correspondiente.
DIAN_WSDL=https://vpfe-hab.dian.gov.co/Wcf/DocumentManagementService.svc?wsdl
DIAN_USUARIO=
DIAN_CLAVE=
# Ruta al certificado PKCS12 de la empresa (para firmar el XML con XAdES-EPES).
DIAN_CERTIFICADO=
DIAN_CLAVE_CERTIFICADO=
# Timeout en segundos para el WSDL y cada llamada SOAP con DIAN_MOCK=False;
# sin esto una DIAN colgada bloquea el hilo indefinidamente.
DIAN_TIMEOUT=20

# ------------------------------- Notificaciones / WhatsApp ---------
# WhatsApp solo se envia si WA_VINCULADO=True con WA_TOKEN y WA_NUMERO.
# Si no, el notificador cae al canal alterno (EMAIL). El token es secreto:
# nunca lo subas al repo.
WA_VINCULADO=False
WA_API_URL=https://graph.facebook.com/v18.0/
WA_TOKEN=
# Numero de telefono del remitente (se usa como "from" en la API de WhatsApp).
WA_NUMERO=

# ------------------------------- Seguridad de produccion (opcional) -
# Estos valores ya tienen buenos defaults automaticos cuando DEBUG=False.
# Solo necesitas cambiarlos si tu despliegue los exige.
# Cuando hay HTTPS (proxy/reverse proxy) se activa SECURE_SSL_REDIRECT=True.
#SECURE_SSL_REDIRECT=True
#SESSION_COOKIE_SECURE=True
#CSRF_COOKIE_SECURE=True
#SECURE_HSTS_SECONDS=31536000

# --------------------------------------------- Media / archivos ---
# Directorio y URL publica de archivos (imagenes de producto, comprobantes
# DIAN, streams de camaras). En multi-servidor apunta MEDIA_ROOT a un disco
# compartido/volumen. Object storage (S3) requiere django-storages (dependencia
# nueva -> aprobar con el supervisor antes de tocar requirements.txt).
#MEDIA_ROOT=./media
#MEDIA_URL=/media/

# ------------------------------------- Backups y monitoreo (ops) ---
# `manage.py backup_db` guarda respaldos .sql en BACKUP_DIR (nunca subido
# a git) y conserva los ultimos BACKUP_RETENER_DIAS dias. `manage.py monitor`
# verifica BD/migraciones/cache/disco y alerta si el ultimo respaldo supera
# MONITOR_ALERTA_BACKUP_HORAS horas. Si mysqldump/mysql no estan en tu PATH
# (p. ej. Laragon), indica la ruta en MYSQLDUMP_BIN/MYSQL_BIN.
#BACKUP_DIR=./backups
#BACKUP_RETENER_DIAS=7
#MONITOR_ALERTA_BACKUP_HORAS=24
#MYSQLDUMP_BIN=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe
#MYSQL_BIN=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysql.exe

# ----------------------------------- Throttling por IP (opcional) ---
# Limites por IP de endpoints sensitivos de autenticacion (refresh,
# recuperacion de contrasena y creacion de cuentas). Cambia estos valores
# solo si tu despliegue los exige; los defaults ya son razonables.
# Formato DRF: "<cantidad>/<segundos|minute|hour>".
#THROTTLE_REFRESH=120/hour
#THROTTLE_RECUPERACION=20/10min
#THROTTLE_REGISTRO=10/hour
